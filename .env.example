# ===========================================
# Mumei Agent Config
# ===========================================

# --- LLM Provider Config ---

# Pattern 1: Ollama local (Docker Compose recommended: free, privacy-preserving)
# Prerequisite: `docker compose up -d` -> `docker exec mumei-ollama ollama pull qwen2.5-coder:3b`
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Default is the CPU-friendly qwen2.5-coder:3b (completes in seconds on CPU-only boxes).
LLM_MODEL=qwen2.5-coder:3b
# LLM_MODEL=qwen2.5-coder:7b  # highest accuracy; needs a GPU/Apple-silicon box (2-3x slower and may time out on CPU-only runners)
# LLM_MODEL=qwen2.5-coder:1.5b  # lightweight (VRAM <= 8GB); qwen3.5:4b is another CPU-friendly option

# Pattern 2: External API (e.g. Alibaba Cloud DashScope)
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Pattern 3: vLLM local server
# LLM_API_KEY=dummy
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen3.5-7B

# Pattern 4: OpenAI
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o

# --- Mumei CLI Config ---
# Path to mumei binary (default: "mumei" from PATH)
# For development: MUMEI_BIN="cargo run --manifest-path /path/to/mumei/Cargo.toml --"
# MUMEI_BIN=mumei

# --- Visualizer Config ---
ENABLE_VISUALIZER_SYNC=true

# --- NLAE Integration (Phase 12 - Experimental) ---
# Disabled by default. Set individual flags to true to opt in.
ENABLE_LATENT_DEBUG=false
ENABLE_DENSE_PROPERTIES=false
ENABLE_LATENT_PROTOCOL=false

# --- OpenTelemetry Observability (P15 Phase 1 - opt-in) ---
# Requires the `otel` extra: `uv sync --extra otel`.
# Disabled by default; NoOp tracers/meters are used unless OTEL_ENABLED is
# truthy AND the opentelemetry packages are importable.
OTEL_ENABLED=false
# OTLP endpoint for traces/metrics (Jaeger, Grafana Tempo, etc.).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTLP wire protocol: grpc (default) or http/protobuf.
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
