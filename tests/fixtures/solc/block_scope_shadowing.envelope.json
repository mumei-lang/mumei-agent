        "content": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.39;\n\ncontract Shadow {\n    uint256 count;\n\n    function track() external returns (uint256) {\n        uint256 local = count + 1;\n        {\n            uint256 count = local;\n            count = count + 10;\n        }\n        local = local + 1;\n        return local + count;\n    }\n}\n"
